@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> L

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">@L["Common.About"]</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L["Error.Unhandled"]
    <a href="." class="reload">@L["Common.Reload"]</a>
    <span class="dismiss">🗙</span>
</div>
