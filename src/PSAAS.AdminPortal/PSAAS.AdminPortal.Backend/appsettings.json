{
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "extensions": [
      {
        "assembly": "NLog.Web.AspNetCore"
      }
    ],
    "targets": {
      "stdout": {
        "type": "Console",
        "layout": {
          "type": "JsonLayout",
          "includeEventProperties": true,
          "attributes": [
            {
              "name": "timestamp",
              "layout": "${date:format=o}"
            },
            {
              "name": "level",
              "layout": "${level:uppercase=true}"
            },
            {
              "name": "logger",
              "layout": "${logger}"
            },
            {
              "name": "message",
              "layout": "${message}"
            },
            {
              "name": "messageTemplate",
              "layout": "${message:raw=true}"
            },
            {
              "name": "exception",
              "layout": "${exception:format=tostring}"
            },
            {
              "name": "traceId",
              "layout": "${aspnet-traceidentifier}"
            },
            {
              "name": "requestMethod",
              "layout": "${aspnet-request-method}"
            },
            {
              "name": "requestUrl",
              "layout": "${aspnet-request-url}"
            },
            {
              "name": "user",
              "layout": "${aspnet-user-identity}"
            }
          ]
        }
      }
    },
    "rules": [
      {
        "logger": "Microsoft.Hosting.Lifetime",
        "minLevel": "Info",
        "writeTo": "stdout",
        "final": true
      },
      {
        "logger": "Microsoft.AspNetCore.Hosting.Diagnostics",
        "minLevel": "Info",
        "writeTo": "stdout",
        "final": true
      },
      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "System.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "stdout"
      }
    ]
  },
  "Keycloak": {
    "Mode": "Api",
    "Authority": "https://auth.fin-horizon.com/realms/PSAAS",
    "ClientId": "adminportal-api",
    "ValidateAudience": true,
    "ValidAudiences": [
      "adminportal-api"
    ],
    "RoleResourceClientIds": [
      "adminportal-api"
    ],
    "Policies": [
      {
        "Name": "Administrator",
        "Roles": [
          "Administrator"
        ]
      },
      {
        "Name": "UsageReporter",
        "Roles": [
          "UsageReporter",
          "Administrator"
        ]
      }
    ]
  },
  "Provisioning": {
    "RetryMinutes": 5
  },
  "Billing": {
    "RunHours": 24,
    "SuspendAfterDays": 30
  },
  "ItalianCities": {
    "BaseUrl": "https://raw.githubusercontent.com/matteocontrini/comuni-json/master/comuni.json"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
