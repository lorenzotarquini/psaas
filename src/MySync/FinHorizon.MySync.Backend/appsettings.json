{
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "extensions": [
      {
        "assembly": "NLog.Web.AspNetCore"
      }
    ],
    "targets": {
      "stdout": {
        "type": "Console",
        "layout": {
          "type": "JsonLayout",
          "includeEventProperties": true,
          "includeScopeProperties": true,
          "excludeProperties": "RequestPath,ConnectionId",
          "attributes": [
            {
              "name": "timestamp",
              "layout": "${date:format=o}"
            },
            {
              "name": "level",
              "layout": "${level:uppercase=true}"
            },
            {
              "name": "service",
              "layout": "mysync-backend"
            },
            {
              "name": "logger",
              "layout": "${logger}"
            },
            {
              "name": "message",
              "layout": "${message}"
            },
            {
              "name": "messageTemplate",
              "layout": "${message:raw=true}"
            },
            {
              "name": "exception",
              "layout": "${exception:format=tostring}"
            },
            {
              "name": "traceId",
              "layout": "${aspnet-traceidentifier}"
            }
          ]
        }
      },
      "console": {
        "type": "Console",
        "layout": "${date:format=yyyy-MM-dd HH\\:mm\\:ss.fff}|${level:uppercase=true}|${logger}|${message}${onexception:inner=${newline}${exception:format=tostring}}"
      },
      "jsonFile": {
        "type": "File",
        "fileName": "${configsetting:item=Logs.Directory:whenEmpty=${basedir}/logs}/mysync-backend.log",
        "archiveAboveSize": 10485760,
        "maxArchiveFiles": 5,
        "layout": {
          "type": "JsonLayout",
          "includeEventProperties": true,
          "includeScopeProperties": true,
          "excludeProperties": "RequestPath,ConnectionId",
          "attributes": [
            {
              "name": "timestamp",
              "layout": "${date:format=o}"
            },
            {
              "name": "level",
              "layout": "${level:uppercase=true}"
            },
            {
              "name": "service",
              "layout": "mysync-backend"
            },
            {
              "name": "logger",
              "layout": "${logger}"
            },
            {
              "name": "message",
              "layout": "${message}"
            },
            {
              "name": "messageTemplate",
              "layout": "${message:raw=true}"
            },
            {
              "name": "exception",
              "layout": "${exception:format=tostring}"
            },
            {
              "name": "traceId",
              "layout": "${aspnet-traceidentifier}"
            }
          ]
        }
      }
    },
    "rules": [
      {
        "logger": "Microsoft.Hosting.Lifetime",
        "minLevel": "Info",
        "writeTo": "stdout",
        "final": true
      },
      {
        "logger": "Microsoft.AspNetCore.Hosting.Diagnostics",
        "minLevel": "Warn",
        "writeTo": "stdout",
        "final": true
      },
      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "System.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "stdout"
      }
    ]
  },
  "Keycloak": {
    "Mode": "Api",
    "Authority": "https://auth.fin-horizon.com/realms/PSAAS",
    "ClientId": "mysync-api",
    "ValidateAudience": true,
    "ValidAudiences": [
      "mysync-api"
    ],
    "RoleResourceClientIds": [
      "mysync-api"
    ],
    "Policies": [
      {
        "Name": "User",
        "Roles": [
          "module-mysync"
        ]
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
