{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Keycloak": {
    "Authority": "https://auth.fin-horizon.com/realms/PSAAS",
    "ClientId": "adminportal",
    "Mode": "Web",
    "RequireHttpsMetadata": true,
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "RemoteSignOutPath": "/signout-oidc",
    "RoleResourceClientIds": [ "adminportal" ],
    "Policies": [
      {
        "Name": "Administrator",
        "Roles": [ "Administrator" ]
      }
    ]
  }
}
