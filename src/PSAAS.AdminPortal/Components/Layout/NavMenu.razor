@inject IStringLocalizer<SharedResource> L

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@L["App.Brand"]</a>
    </div>
</div>

<input type="checkbox" title="@L["Nav.MenuToggleTitle"]" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav-menu">
        <MudNavMenu Dense="true" Class="nav-links">
            <MudNavLink Href="/societa" Icon="@Icons.Material.Filled.Business" Match="NavLinkMatch.Prefix">
                @L["Nav.Companies"]
            </MudNavLink>
            <MudNavLink Href="/utenti" Icon="@Icons.Material.Filled.Group" Match="NavLinkMatch.Prefix">
                @L["Nav.Users"]
            </MudNavLink>
        </MudNavMenu>

        <div class="nav-footer px-3">
            <MudDivider Class="nav-divider" />
            <MudButton Variant="Variant.Text"
                       Color="Color.Inherit"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Logout"
                       Disabled="true">
                @L["Nav.Logout"]
            </MudButton>
        </div>
    </nav>
</div>

