@page "/organizations/{Id:guid}/edit"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using MudBlazor
@using PSAAS.AdminPortal
@using PSAAS.AdminPortal.Components
@using PSAAS.AdminPortal.Features.Tenants.Services
@using PSAAS.AdminPortal.Features.Tenants.ViewModels
@using PSAAS.Application.Contracts.Tenants
@inherits MvvmComponentBase<TenantEditFormViewModel>
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager NavigationManager

<PageTitle>@L["Tenants.Edit.Title"]</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4" HtmlTag="h1">@L["Tenants.Edit.Title"]</MudText>

    @if (ViewModel.IsLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (ViewModel.IsNotFound)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">@L["Tenants.Edit.NotFound"]</MudAlert>
        <MudStack Row="true" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/organizations">@L["Tenants.Create.Action.Cancel"]</MudButton>
        </MudStack>
    }
    else if (ViewModel.LoadErrorCode is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true">@L["Tenants.Edit.LoadFailed"]</MudAlert>
        <MudStack Row="true" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/organizations">@L["Tenants.Create.Action.Cancel"]</MudButton>
        </MudStack>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudForm>
                <MudStack Spacing="4">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="@L["Tenants.Create.Field.CompanyName"]" Value="@ViewModel.CompanyName" ValueChanged="@(value => ViewModel.CompanyName = value)" Immediate="true" DebounceInterval="2000" OnDebounceIntervalElapsed="@(_ => ViewModel.ValidateCompanyNameAsync())" OnBlur="@(_ => ViewModel.ValidateCompanyNameAsync())" Error="@(ViewModel.CompanyNameErrorCode is not null)" ErrorText="@ValidationMessage(ViewModel.CompanyNameErrorCode)" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="@L["Tenants.Create.Field.VatNumber"]" Value="@ViewModel.VatNumber" ValueChanged="@(value => ViewModel.VatNumber = value)" Immediate="true" DebounceInterval="2000" OnDebounceIntervalElapsed="@(_ => ViewModel.ValidateVatNumberAsync())" OnBlur="@(_ => ViewModel.ValidateVatNumberAsync())" Error="@(ViewModel.VatNumberErrorCode is not null)" ErrorText="@ValidationMessage(ViewModel.VatNumberErrorCode)" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="@L["Tenants.Create.Field.CertifiedEmail"]" Value="@ViewModel.CertifiedEmail" ValueChanged="@(value => ViewModel.CertifiedEmail = value)" Immediate="true" DebounceInterval="2000" OnDebounceIntervalElapsed="@(_ => ViewModel.ValidateCertifiedEmailAsync())" OnBlur="@(_ => ViewModel.ValidateCertifiedEmailAsync())" Error="@(ViewModel.CertifiedEmailErrorCode is not null)" ErrorText="@ValidationMessage(ViewModel.CertifiedEmailErrorCode)" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle1" HtmlTag="h2">@L["Tenants.Create.Section.Address"]</MudText>
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" Label="@L["Tenants.Create.Field.Street"]" Value="@ViewModel.Street" ValueChanged="@(value => ViewModel.Street = value)" Immediate="true" OnBlur="@(_ => ViewModel.ValidateStreet())" Error="@(ViewModel.StreetErrorCode is not null)" ErrorText="@ValidationMessage(ViewModel.StreetErrorCode)" Variant="Variant.Outlined" FullWidth="true" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" Label="@L["Tenants.Create.Field.City"]" Value="@ViewModel.City" ValueChanged="@(value => ViewModel.City = value)" Immediate="true" OnBlur="@(_ => ViewModel.ValidateCity())" Error="@(ViewModel.CityErrorCode is not null)" ErrorText="@ValidationMessage(ViewModel.CityErrorCode)" Variant="Variant.Outlined" FullWidth="true" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" Label="@L["Tenants.Create.Field.PostalCode"]" Value="@ViewModel.PostalCode" ValueChanged="@(value => ViewModel.PostalCode = value)" Immediate="true" OnBlur="@(_ => ViewModel.ValidatePostalCode())" Error="@(ViewModel.PostalCodeErrorCode is not null)" ErrorText="@ValidationMessage(ViewModel.PostalCodeErrorCode)" Variant="Variant.Outlined" FullWidth="true" />
                            </MudItem>
                            <MudItem xs="12" md="8">
                                <MudSelect T="string" Label="@L["Tenants.Create.Field.Country"]" Value="@ViewModel.Country" ValueChanged="@(value => ViewModel.Country = value)" OnBlur="@(_ => ViewModel.ValidateCountry())" Error="@(ViewModel.CountryErrorCode is not null)" ErrorText="@ValidationMessage(ViewModel.CountryErrorCode)" Variant="Variant.Outlined" FullWidth="true">
                                    <MudSelectItem T="string" Value="@("Italia")">@L["Tenants.Create.Country.Italy"]</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudStack>

                    @if (ViewModel.SaveErrorCode is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">@SaveMessage</MudAlert>
                    }

                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Close" Href="/organizations">@L["Tenants.Create.Action.Cancel"]</MudButton>
                        <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(ViewModel.IsSaving)" OnClick="HandleSaveAsync" StartIcon="@Icons.Material.Filled.Save">@L["Tenants.Create.Action.Save"]</MudButton>
                    </MudStack>
                </MudStack>
            </MudForm>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    protected override Task OnInitializedAsync()
    {
        ViewModel.TenantId = Id;
        return base.OnInitializedAsync();
    }

    private async Task HandleSaveAsync()
    {
        if (await ViewModel.SubmitAsync())
        {
            NavigationManager.NavigateTo("/organizations");
        }
    }

    private string? ValidationMessage(string? errorCode) => errorCode switch
    {
        null => null,
        TenantFieldValidationErrorCodes.Required => L["Validation.Required"].Value,
        TenantFieldValidationErrorCodes.InvalidFormat => L["Validation.InvalidFormat"].Value,
        TenantFieldValidationErrorCodes.MaxLengthExceeded => L["Validation.MaxLengthExceeded"].Value,
        TenantFieldValidationErrorCodes.NotUnique => L["Validation.NotUnique"].Value,
        _ => L["Validation.Invalid"].Value
    };

    private string SaveMessage => ViewModel.SaveErrorCode switch
    {
        TenantEditErrorCodes.NotFound => L["Tenants.Edit.NotFound"].Value,
        TenantEditErrorCodes.SaveFailed => L["Tenants.Edit.SaveFailed"].Value,
        _ => L["Error.Unhandled"].Value
    };
}
