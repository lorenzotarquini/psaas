@inject IStringLocalizer<SharedResource> L

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@L["App.Brand"]</a>
    </div>
</div>

<input type="checkbox" title="@L["Nav.MenuToggleTitle"]" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav-menu">
        <MudNavMenu Dense="true" Class="nav-links">
            <MudNavLink Href="/organizations" Match="NavLinkMatch.Prefix">
                <span class="nav-item-content">
                    <i class="fas fa-building nav-item-icon" aria-hidden="true"></i>
                    <span>@L["Nav.Companies"]</span>
                </span>
            </MudNavLink>
            <MudNavLink Href="/utenti" Match="NavLinkMatch.Prefix">
                <span class="nav-item-content">
                    <i class="fas fa-users nav-item-icon" aria-hidden="true"></i>
                    <span>@L["Nav.Users"]</span>
                </span>
            </MudNavLink>
        </MudNavMenu>

        <div class="nav-footer">
            <MudDivider Class="nav-divider" />
            <form method="post" action="/authentication/logout">
                <AntiforgeryToken />
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           FullWidth="true">
                    <span class="nav-item-content">
                        <i class="fas fa-sign-out-alt nav-item-icon" aria-hidden="true"></i>
                        <span>@L["Nav.Logout"]</span>
                    </span>
                </MudButton>
            </form>
        </div>
    </nav>
</div>
