@PSAAS.AdminPortal.Backend_HostAddress = http://localhost:5192
@token = <access token Keycloak>
@tenantId = <guid tenant>
@profileId = <id profilo>

GET {{PSAAS.AdminPortal.Backend_HostAddress}}/health

###

GET {{PSAAS.AdminPortal.Backend_HostAddress}}/api/me
Authorization: Bearer {{token}}

###

GET {{PSAAS.AdminPortal.Backend_HostAddress}}/api/tenants?search=&page=1&pageSize=20
Authorization: Bearer {{token}}

###

GET {{PSAAS.AdminPortal.Backend_HostAddress}}/api/tenants/{{tenantId}}
Authorization: Bearer {{token}}

###

GET {{PSAAS.AdminPortal.Backend_HostAddress}}/api/profiles
Authorization: Bearer {{token}}

###

# UC9: a profile of an organization, then deleted (use the id of the response)
POST {{PSAAS.AdminPortal.Backend_HostAddress}}/api/profiles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tenantId": "{{tenantId}}",
  "name": "Revisore",
  "description": "Sola lettura"
}

###

DELETE {{PSAAS.AdminPortal.Backend_HostAddress}}/api/profiles/{{profileId}}
Authorization: Bearer {{token}}

###

GET {{PSAAS.AdminPortal.Backend_HostAddress}}/api/geography/cities?term=ro
Authorization: Bearer {{token}}

###
POST {{PSAAS.AdminPortal.Backend_HostAddress}}/api/tenants
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "companyName": "Acme Srl",
  "completeVatNumber": "IT12345678901",
  "certifiedEmail": "acme@pec.it",
  "street": "Via Roma 1",
  "city": "Roma",
  "postalCode": "00118",
  "profiles": [ { "key": "op", "name": "Operatore" } ],
  "productiveUnits": [ { "name": "Stabilimento", "profileKeys": [ "op" ] } ]
}

###
# UC3-R9: a private person (B2C); it gets the "Personale" unit and profile
POST {{PSAAS.AdminPortal.Backend_HostAddress}}/api/tenants
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "kind": "Individual",
  "companyName": "Mario Rossi",
  "completeVatNumber": "RSSMRA85T10A562S",
  "certifiedEmail": "mario.rossi@example.com",
  "street": "Via Roma 1",
  "city": "Roma",
  "postalCode": "00118"
}

###

GET {{PSAAS.AdminPortal.Backend_HostAddress}}/api/tenants/field-validation?field=companyName&value=Acme%20Srl
Authorization: Bearer {{token}}

###

GET {{PSAAS.AdminPortal.Backend_HostAddress}}/api/users?search=mario
Authorization: Bearer {{token}}

###
POST {{PSAAS.AdminPortal.Backend_HostAddress}}/api/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "Mario",
  "lastName": "Rossi",
  "email": "mario.rossi@example.com",
  "profileIds": []
}

###
