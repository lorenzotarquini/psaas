[*.cs]
# Result<T>.Ok(...) / Invalid(...) factories are the idiom of the use cases; a non-generic twin would only add noise.
dotnet_diagnostic.CA1000.severity = none
# MySync is C# only: names such as "Date" clashing with Visual Basic keywords are not a concern.
dotnet_diagnostic.CA1716.severity = none

# EF Core migrations are generated by the tooling.
[**/Migrations/*.cs]
generated_code = true
